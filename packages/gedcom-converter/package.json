{
  "name": "@treeviz/gedcom-convert",
  "version": "1.0.0",
  "description": "Standalone GEDCOM conversion library supporting multiple output formats: JSON, Excel, CSV, DOCX, PDF, vCard, SVG, and GEDCOM.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "gedcom-convert": "./bin/gedcom-convert.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./converters": {
      "types": "./dist/converters/index.d.ts",
      "import": "./dist/converters/index.js"
    },
    "./converters/*": {
      "types": "./dist/converters/*.d.ts",
      "import": "./dist/converters/*.js"
    },
    "./factories": {
      "types": "./dist/factories/index.d.ts",
      "import": "./dist/factories/index.js"
    },
    "./factories/*": {
      "types": "./dist/factories/*.d.ts",
      "import": "./dist/factories/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@treeviz/gedcom-parser": "^2.0.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "csv-stringify": "^6.7.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.23",
    "@types/pdfkit": "^0.17.5",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.7"
  },
  "keywords": [
    "gedcom",
    "genealogy",
    "converter",
    "export",
    "family-tree",
    "typescript",
    "treeviz",
    "json",
    "excel",
    "pdf",
    "docx",
    "csv",
    "svg",
    "vcard",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
